<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>../../packaging/EmbeddedHelper.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(PortablePayload)' != ''">
    <EmbeddedResource Include="$(PortablePayload)/payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(PortablePayload)/payload.json" LogicalName="payload.json" />
  </ItemGroup>
</Project>
