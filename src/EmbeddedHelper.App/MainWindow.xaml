<Window x:Class="EmbeddedHelper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App" Title="Embedded Helper" Icon="Assets/EmbeddedHelper.png" Width="1280" Height="860" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#14243B" Padding="24,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Image Source="Assets/EmbeddedHelper.png" Width="52" Height="52" Margin="0,0,14,0"/><StackPanel><TextBlock Text="EMBEDDED HELPER" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="工程配置 · 变量观察 · 串口通信" Foreground="#AEBED3" Margin="0,6,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#93C5FD" HorizontalAlignment="Right"/><TextBlock Text="开发内测 · 硬件链路未验收" Foreground="#FDE68A" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE3EE" BorderThickness="0,1,0,0" Padding="18,10"><TextBlock x:Name="StatusLabel" Text="就绪。可直接使用串口，或打开工程。" TextWrapping="Wrap"/></Border>
    <TabControl x:Name="Pages" Margin="16" Background="Transparent" BorderThickness="0">
      <TabItem Header="工程"><local:ProjectView x:Name="ProjectPage" BrowseProjectRequested="BrowseProject" OpenProjectRequested="OpenProject" TargetChangedRequested="TargetChanged" BrowseElfRequested="BrowseElf" ParseElfRequested="ParseElf" OpenRecentRequested="OpenRecent"/></TabItem>
      <TabItem Header="变量与 RTT"><local:ObservationView x:Name="ObservationPage" StartObservationRequested="StartObservation" StopObservationRequested="StopObservation" ParseElfRequested="ParseElf" PlotSizeChangedRequested="PlotSizeChanged" ClearRttRequested="ClearRtt"/></TabItem>
      <TabItem Header="远程配置"><local:RemoteView x:Name="RemotePage" OpenWebRequested="OpenWeb" PreviewIntegrationRequested="PreviewIntegration" PreviewConfigRequested="PreviewConfig" PreviewRemoveIntegrationRequested="PreviewRemoveIntegration" RecoverConfigRequested="RecoverConfig" ApplyConfigRequested="ApplyConfig"/></TabItem>
      <TabItem Header="串口助手"><local:SerialView x:Name="SerialPage" RefreshPortsRequested="RefreshPorts" ToggleSerialRequested="ToggleSerial" SerialEncodingChangedRequested="SerialEncodingChanged" ClearSerialRequested="ClearSerial" SelectSendHistoryRequested="SelectSendHistory" SendSerialRequested="SendSerial" StartPeriodicRequested="StartPeriodic" StopPeriodicRequested="StopPeriodic" OpenRecordsRequested="OpenRecords"/></TabItem>
      <TabItem Header="设置与诊断"><local:SettingsView x:Name="SettingsPage" BrowseDllRequested="BrowseDll" SaveSettingsRequested="SaveSettings" EnvironmentCheckRequested="EnvironmentCheck" OpenLogsRequested="OpenLogs" RefreshToolsRequested="RefreshTools" DownloadToolRequested="DownloadTool" ImportToolRequested="ImportTool" BindCliRequested="BindCli"/></TabItem>
    </TabControl>
  </DockPanel>
</Window>
