<Window x:Class="EmbeddedHelper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Embedded Helper" Icon="Assets/EmbeddedHelper.png" Width="1280" Height="860" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#14243B" Padding="24,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Image Source="Assets/EmbeddedHelper.png" Width="52" Height="52" Margin="0,0,14,0"/><StackPanel><TextBlock Text="EMBEDDED HELPER" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="工程配置 · 变量观察 · 串口通信" Foreground="#AEBED3" Margin="0,6,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#93C5FD" HorizontalAlignment="Right"/><TextBlock Text="开发内测 · 硬件链路未验收" Foreground="#FDE68A" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE3EE" BorderThickness="0,1,0,0" Padding="18,10"><TextBlock x:Name="StatusLabel" Text="就绪。可直接使用串口，或打开工程。" TextWrapping="Wrap"/></Border>
    <TabControl x:Name="Pages" Margin="16" Background="Transparent" BorderThickness="0">
      <TabItem Header="工程">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
          <TextBlock Text="打开你的工程" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="读取 EIDE 工程与已有配置。打开操作不会构建、烧录或连接设备。" Foreground="#64748B" Margin="0,0,0,20"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseProject"/><Button DockPanel.Dock="Right" Content="打开工程" Style="{StaticResource Primary}" Click="OpenProject"/><TextBox x:Name="ProjectPath" ToolTip="工程目录或 .code-workspace 文件"/></DockPanel>
          <GroupBox Header="当前工程"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProjectSummary" Text="尚未打开工程" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="McuLabel" Margin="0,10" TextWrapping="Wrap"/><TextBlock Text="构建目标"/><ComboBox x:Name="TargetBox" DisplayMemberPath="Name" SelectionChanged="TargetChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="固件文件（ELF）"/><TextBox x:Name="ElfPath" IsReadOnly="True" TextWrapping="Wrap"/><WrapPanel><Button Content="选择 ELF" Click="BrowseElf"/><Button Content="解析变量" Click="ParseElf" Style="{StaticResource Primary}"/></WrapPanel><TextBlock Text="选择外部 ELF 只用于本次查看；不会复制或修改固件。" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></Grid></GroupBox>
          <GroupBox Header="配置来源与诊断"><TextBox x:Name="ProjectDiagnostics" IsReadOnly="True" MinHeight="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
          <GroupBox Header="最近工程"><ListBox x:Name="RecentProjects" MinHeight="75" MaxHeight="150" MouseDoubleClick="OpenRecent" BorderThickness="0"/></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="变量与 RTT">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
          <WrapPanel><ComboBox x:Name="TransportBox" SelectedIndex="0" Width="145"><ComboBoxItem Content="本地 USB"/><ComboBoxItem Content="远程 IP"/></ComboBox><TextBlock Text="探针序列号" VerticalAlignment="Center" Margin="0,0,8,10"/><TextBox x:Name="ProbeSerial" Width="135"/><TextBlock Text="请求 Hz" VerticalAlignment="Center" Margin="0,0,8,10"/><TextBox x:Name="SampleRate" Text="100" Width="65"/><CheckBox x:Name="EnableRtt" Content="本地 RTT 通道 0" IsChecked="True"/><Button x:Name="StartButton" Content="开始采集" Style="{StaticResource Primary}" Click="StartObservation"/><Button Content="停止并释放" Click="StopObservation"/><CheckBox x:Name="PauseObservation" Content="暂停显示"/></WrapPanel>
          <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="更新变量地址" Click="ParseElf"/><TextBlock x:Name="ObservationStatus" Text="未连接 · ELF 与固件匹配未核验" Foreground="#64748B" Margin="0,8" TextWrapping="Wrap"/></DockPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DataGrid x:Name="VariableGrid" ItemsSource="{Binding Variables}" SelectionMode="Extended"><DataGrid.Columns><DataGridCheckBoxColumn Header="观察" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="变量 / 类型" Binding="{Binding Label}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="110" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Background="#101D31" CornerRadius="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="变量曲线 · 最近 2000 个显示点" Foreground="#94A3B8" Margin="0,0,0,8"/><Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="PlotSizeChanged"/></DockPanel></Border>
          </Grid>
          <GroupBox Grid.Row="3" Header="RTT · Up 0" Margin="0,14,0,0" Padding="8"><DockPanel><Button DockPanel.Dock="Right" Content="清屏" Click="ClearRtt" VerticalAlignment="Top"/><TextBox x:Name="RttText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0" BorderThickness="0"/></DockPanel></GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="远程配置">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="维护工程连接参数" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="远程探针端口与网页端口不同。配置写入不会执行烧录。" Foreground="#64748B" Margin="0,8,0,20"/>
          <GroupBox Header="J-Link Remote Server"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="服务器主机名 / IP"/><TextBox x:Name="RemoteHost"/><TextBlock Text="网页地址（可选）"/><TextBox x:Name="WebAddress"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="远程探针端口"/><TextBox x:Name="RemotePort" Text="19011"/><TextBlock Text="本机 GDB 端口"/><TextBox x:Name="GdbPort" Text="2331"/><Button Content="停止采集并打开 RTT 网页" Click="OpenWeb" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Grid></GroupBox>
          <CheckBox x:Name="UseEideUpload" Content="同时切换 EIDE 上传按钮（适配 3.27.2，可恢复）"/><TextBlock Text="远程变量与网页 RTT 手动二选一；开始远程采集前请先在网页停止 RTT。" TextWrapping="Wrap"/><WrapPanel><Button Content="预览 VS Code 接入" Click="PreviewIntegration" Style="{StaticResource Primary}"/><Button Content="仅预览连接参数" Click="PreviewConfig"/><Button Content="预览移除接入" Click="PreviewRemoveIntegration"/><Button Content="恢复未完成写入" Click="RecoverConfig"/><Button x:Name="ApplyConfigButton" Content="应用已预览的修改" Click="ApplyConfig" IsEnabled="False"/></WrapPanel>
          <GroupBox Header="修改预览"><TextBox x:Name="ConfigPreview" IsReadOnly="True" Height="260" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/></GroupBox>
          <TextBlock Text="VS Code 一键接入与版本化 Debug_LAN 工具将在后续批次提供；当前仅维护兼容的 remote-jlink.json。已有任务继续独立使用。" TextWrapping="Wrap" Foreground="#92400E"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="串口助手">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel><StackPanel><TextBlock Text="端口"/><ComboBox x:Name="SerialPortBox" IsEditable="True" Width="115"/></StackPanel><StackPanel><TextBlock Text="波特率"/><ComboBox x:Name="BaudBox" IsEditable="True" Text="115200" Width="120"><ComboBoxItem Content="9600"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="1000000"/><ComboBoxItem Content="5000000"/></ComboBox></StackPanel><StackPanel><TextBlock Text="数据位"/><ComboBox x:Name="DataBitsBox" SelectedIndex="3"><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/></ComboBox></StackPanel><StackPanel><TextBlock Text="校验"/><ComboBox x:Name="ParityBox"/></StackPanel><StackPanel><TextBlock Text="停止位"/><ComboBox x:Name="StopBitsBox"/></StackPanel><StackPanel><TextBlock Text="流控"/><ComboBox x:Name="FlowBox" Width="150"/></StackPanel></WrapPanel>
          <WrapPanel Grid.Row="1"><Button Content="刷新端口" Click="RefreshPorts"/><Button x:Name="ConnectSerialButton" Content="打开串口" Click="ToggleSerial" Style="{StaticResource Primary}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,8"><Ellipse x:Name="SerialConnectionLight" Width="13" Height="13" Fill="Firebrick" Margin="0,0,6,0"/><TextBlock x:Name="SerialConnectionLabel" Text="未连接" VerticalAlignment="Center"/></StackPanel><CheckBox x:Name="RecordSerial" Content="保存双向原始记录" ToolTip="在打开串口时应用；修改后重新打开生效" IsChecked="True"/><ComboBox x:Name="EncodingBox" Width="100" SelectionChanged="SerialEncodingChanged" ToolTip="文本收发编码；切换会清空显示窗口，原始记录不变"/><CheckBox x:Name="HexDisplay" Content="HEX 显示" Checked="SerialEncodingChanged" Unchecked="SerialEncodingChanged"/><CheckBox x:Name="PauseSerial" Content="暂停显示"/><Button Content="清屏" Click="ClearSerial"/></WrapPanel>
          <TextBlock Grid.Row="2" TextWrapping="Wrap" x:Name="SerialStats" Text="未连接 · 1 Mbps 待实机验收，5 Mbps 为实验档；RS485仅支持转接器硬件自动换向" Foreground="#64748B" Margin="0,4,0,12"/>
          <TextBox Grid.Row="3" x:Name="SerialText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#101D31" Foreground="#D1E5FF" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="4"><TextBlock Text="最近发送" Foreground="#64748B"/><ComboBox x:Name="SendHistoryBox" SelectionChanged="SelectSendHistory" ToolTip="最近发送内容（最多20项）"/><TextBox x:Name="SendText" AcceptsReturn="True" MinHeight="66" MaxHeight="110" VerticalScrollBarVisibility="Auto" ToolTip="发送文本或以空格分隔的十六进制字节"/></StackPanel>
          <WrapPanel Grid.Row="5"><CheckBox x:Name="HexSend" Content="HEX 发送"/><ComboBox x:Name="NewlineBox" SelectedIndex="0"><ComboBoxItem Content="不加换行"/><ComboBoxItem Content="LF"/><ComboBoxItem Content="CRLF"/></ComboBox><Button Content="发送" Click="SendSerial" Style="{StaticResource Primary}"/><TextBlock Text="周期 ms" VerticalAlignment="Center" Margin="8,0,8,10"/><TextBox x:Name="SendPeriod" Text="1000" Width="80"/><Button Content="周期发送" Click="StartPeriodic"/><Button Content="取消周期" Click="StopPeriodic"/><Button Content="打开记录目录" Click="OpenRecords"/></WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="设置与诊断">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="工具与便携设置" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <GroupBox Header="SEGGER 软件"><TextBlock Text="选择外部安装的 JLink_x64.dll；本软件包不分发 SEGGER 库。" Margin="0,0,0,8"/></GroupBox>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择 DLL" Click="BrowseDll"/><TextBox x:Name="DllPath"/></DockPanel><WrapPanel><Button Content="保存设置" Click="SaveSettings" Style="{StaticResource Primary}"/><Button Content="环境检查" Click="EnvironmentCheck"/><Button Content="打开日志目录" Click="OpenLogs"/></WrapPanel>
          <GroupBox Header="DWARF5 解析（可选 ARM 工具链）"><StackPanel><TextBlock Text="DWARF4 内置解析；DWARF5 使用现有 arm-none-eabi-readelf.exe。自动检测 EIDE 安装位置，也可填写完整路径。" TextWrapping="Wrap"/><TextBox x:Name="ReadElfPath"/></StackPanel></GroupBox>
          <GroupBox Header="Debug_LAN 工具版本"><StackPanel><TextBlock Text="从 Template 官方 Release 下载，或导入原版 ZIP；每个版本独立保留。仅准备工具不会连接设备或改变工程。" TextWrapping="Wrap"/><WrapPanel><ComboBox x:Name="ToolVersionBox" DisplayMemberPath="Version" Width="180"/><Button Content="检查官方更新" Click="RefreshTools"/><Button Content="下载并校验" Click="DownloadTool"/><Button Content="导入离线 ZIP" Click="ImportTool"/><Button Content="绑定本机 VS Code 入口" Click="BindCli"/></WrapPanel><TextBlock x:Name="ToolStatus" Text="尚未准备工具；请先选择版本。移动便携目录后需重新绑定入口。" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="环境诊断"><TextBox x:Name="EnvironmentText" IsReadOnly="True" MinHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
          <GroupBox Header="使用说明"><TextBlock Text="1. 将完整 ZIP 解压到可写目录，双击 EmbeddedHelper.exe。升级时保留 data。&#x0a;2. 打开工程、选择目标和 ELF；只有受支持的固定地址标量可加入观察。&#x0a;3. 采集前填写探针序列号与 DLL 路径。停止并释放后，再使用外部烧录或调试工具。&#x0a;4. 串口记录保存在 data/serial/records；序号表示主机观察顺序，不代表对端确认。&#x0a;5. 本版硬件未验收；远程一键接入与工具版本管理仍在开发。" TextWrapping="Wrap" LineHeight="26"/></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
