<UserControl x:Class="EmbeddedHelper.App.ProjectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,0,0">
          <TextBlock Text="打开你的工程" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="读取 EIDE 工程与已有配置。打开操作不会构建、烧录或连接设备。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="BrowseProject"/><Button DockPanel.Dock="Right" Content="打开工程" Style="{StaticResource Primary}" Click="OpenProject"/><TextBox x:Name="ProjectPath" ToolTip="工程目录或 .code-workspace 文件"/></DockPanel>
          <GroupBox Header="当前工程"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProjectSummary" Text="尚未打开工程" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="McuLabel" Margin="0,10" TextWrapping="Wrap"/><TextBlock Text="构建目标"/><ComboBox x:Name="TargetBox" DisplayMemberPath="Name" SelectionChanged="TargetChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="固件文件（ELF）"/><TextBox x:Name="ElfPath" IsReadOnly="True" TextWrapping="Wrap"/><WrapPanel><Button x:Name="BrowseElfButton" Content="选择 ELF" Click="BrowseElf"/><Button x:Name="ParseElfButton" Content="解析变量" Click="ParseElf" Style="{StaticResource Primary}"/></WrapPanel><TextBlock x:Name="ElfStatus" Text="尚未解析 ELF" TextWrapping="Wrap" Margin="0,4,0,6"/><Expander x:Name="ElfDetailsPanel" Header="解析详细信息" Visibility="Collapsed"><TextBox x:Name="ElfDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/></Expander><TextBlock Text="选择外部 ELF 只用于本次查看；不会复制或修改固件。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid></GroupBox>
          <GroupBox Header="配置来源与诊断"><TextBox x:Name="ProjectDiagnostics" IsReadOnly="True" MinHeight="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
          <GroupBox Header="最近工程"><ListBox x:Name="RecentProjects" MinHeight="75" MaxHeight="110" MouseDoubleClick="OpenRecent" BorderThickness="0"/></GroupBox>
        </StackPanel></ScrollViewer>
</UserControl>
