<UserControl x:Class="EmbeddedHelper.App.ObservationSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,6,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="观察设置" Style="{StaticResource PageTitle}"/><TextBlock Text="选择本工程的连接方式、变量和 RTT。保存后，查看变量页使用工程内的设置。" Style="{StaticResource Description}"/></StackPanel>
    <GroupBox Grid.Row="1" Header="连接与采样"><StackPanel>
      <WrapPanel><StackPanel><TextBlock Text="连接方式"/><ComboBox x:Name="TransportBox" SelectedIndex="0" Width="145" SelectionChanged="TransportChanged"><ComboBoxItem Content="本地 USB"/><ComboBoxItem Content="远程 IP"/></ComboBox></StackPanel><StackPanel><TextBlock Text="本地探针序列号"/><TextBox x:Name="ProbeSerial" Width="170" ToolTip="本地连接必须填写具体序列号，不自动选择探针"/></StackPanel><StackPanel><TextBlock Text="采样率 / Hz"/><TextBox x:Name="SampleRate" Text="100" Width="100" ToolTip="1～1000 Hz"/></StackPanel><CheckBox x:Name="EnableRtt" Content="本地 RTT 通道 0" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
      <TextBlock Text="远程 IP 读取工程的远程配置；远程变量与网页 RTT 手动二选一。本机 DLL 路径在设置与诊断中维护。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel></GroupBox>
    <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="解析 / 更新 ELF" Click="ParseElf"/><TextBlock Text="观察变量" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  勾选已有标量，最多 64 项" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
    <DataGrid Grid.Row="3" x:Name="VariableGrid" ItemsSource="{Binding Variables}" SelectionMode="Extended"><DataGrid.Columns>
      <DataGridCheckBoxColumn Header="观察" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
      <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="变量 / 类型" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
      <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="地址" Binding="{Binding Address}" Width="130" IsReadOnly="True"/>
      <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="状态" Binding="{Binding Variable.Status}" Width="180" IsReadOnly="True"/>
    </DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="保存工程观察设置" Style="{StaticResource Primary}" Click="Save" Margin="8,0,0,0"/><TextBlock x:Name="SetupStatus" Text="先打开工程并选择目标；解析 ELF 后勾选变量，也可只使用本地 RTT。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</UserControl>
