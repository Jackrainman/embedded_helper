<UserControl x:Class="EmbeddedHelper.App.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Margin="0,6,0,18"><TextBlock Text="连接配置" Style="{StaticResource PageTitle}"/><TextBlock Text="MCU Viewer 与 RTT 监视共用此工程连接；本地/远程在顶部选择。切换用途前请停止并释放当前采集。" Style="{StaticResource Description}"/>
<GroupBox Header="本机 USB 探针"><StackPanel>
  <TextBlock Text="请选择要连接的 J-Link；软件组件版本在设置页选择。" TextWrapping="Wrap"/>
  <ComboBox x:Name="Probes" DisplayMemberPath="Label" SelectionChanged="ProbeChanged" MinWidth="280"/>
  <Button x:Name="RefreshButton" Content="刷新探针" Click="Refresh" HorizontalAlignment="Left"/>
  <TextBlock Text="本次选择的序列号"/><TextBox x:Name="ProbeSerial" IsReadOnly="True"/>
  <TextBlock Text="MCU、接口和速度沿用当前工程目标。远程连接无需选择本机探针。" TextWrapping="Wrap"/>
  <Button x:Name="SaveButton" Content="保存共享连接" Click="Save" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
</StackPanel></GroupBox>
<TextBlock x:Name="SetupStatus" Text="先打开工程并选择目标。" TextWrapping="Wrap"/>
</StackPanel></UserControl>
