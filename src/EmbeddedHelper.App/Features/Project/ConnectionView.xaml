<UserControl x:Class="EmbeddedHelper.App.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Margin="0,6,0,18"><TextBlock Text="连接配置" Style="{StaticResource PageTitle}"/><TextBlock Text="MCU Viewer 与 RTT 监视共用此工程连接。切换用途前请停止并释放当前采集。" Style="{StaticResource Description}"/>
<GroupBox Header="工程连接"><StackPanel><WrapPanel><StackPanel><TextBlock Text="连接方式"/><ComboBox x:Name="TransportBox" Width="160" SelectedIndex="0" SelectionChanged="TransportChanged"><ComboBoxItem Content="本地 USB"/><ComboBoxItem Content="远程 IP"/></ComboBox></StackPanel><StackPanel><TextBlock Text="本地探针序列号"/><TextBox x:Name="ProbeSerial" Width="200"/></StackPanel></WrapPanel><TextBlock Text="MCU、SWD/JTAG 和调试速度取自工程目标；远程地址及 RTT 网页地址在“远程配置”中预览并保存。" TextWrapping="Wrap"/><Button Content="保存共享连接" Click="Save" HorizontalAlignment="Left" Style="{StaticResource Primary}"/></StackPanel></GroupBox>
<TextBlock x:Name="SetupStatus" Text="先打开工程并选择目标。" TextWrapping="Wrap"/>
</StackPanel></UserControl>
