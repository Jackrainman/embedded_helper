<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="StartButton" Content="{Binding StartText}" Style="{StaticResource Primary}" Click="StartObservation" IsEnabled="{Binding CanStart}"/><Button x:Name="StopButton" Content="停止并释放" Click="StopObservation" IsEnabled="{Binding CanStop}"/><CheckBox x:Name="PauseObservation" Content="暂停显示" IsChecked="{Binding Paused}"/></WrapPanel><TextBlock Text="MCU Viewer" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock x:Name="ConfigurationSummary" Text="{Binding Summary}" Style="{StaticResource Description}"/>
      <Border x:Name="ConfigurationRequired" Visibility="{Binding NeedsConfiguration, Converter={StaticResource VisibleWhenTrue}}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><DockPanel><Button x:Name="ConfigureButton" DockPanel.Dock="Right" Content="{Binding ConfigureText}" Click="Configure" Margin="14,0,0,0"/><StackPanel><TextBlock Text="先补全必要设置" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="ConfigurationIssue" Text="{Binding Issue}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    </StackPanel>
    <DockPanel Grid.Row="1"><WrapPanel DockPanel.Dock="Right"><Button Content="连接配置" Click="Connection"/><Button Content="解析 / 更新 ELF" Click="ParseElf" IsEnabled="{Binding CanEdit}"/></WrapPanel><TextBlock x:Name="ObservationStatus" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="0,8" TextWrapping="Wrap"/></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Surface}"><Grid><DataGrid x:Name="VariableGrid" IsReadOnly="True" ItemsSource="{Binding VisibleRows}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="变量 / 类型" Binding="{Binding Label}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="地址" Binding="{Binding Address}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="当前值" Binding="{Binding Value}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="VariablesEmpty" Text="{Binding VariablesEmpty}" Visibility="{Binding VariablesMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="18"/></Grid></Border>
      <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="变量曲线 · 最近 2000 个显示点 · 前 16 项" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,0,8"/><CheckBox x:Name="IndependentScale" Content="分道独立缩放（各自数值范围）" IsChecked="True" Foreground="{StaticResource ConsoleText}"/></StackPanel><Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:ObservationPlot x:Name="Plot" ClipToBounds="True" Series="{Binding Series}" Labels="{Binding PlotLabels}" Independent="{Binding IsChecked, ElementName=IndependentScale}"/></ScrollViewer><TextBlock x:Name="PlotEmpty" Text="{Binding PlotEmpty}" Visibility="{Binding PlotMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource ConsoleMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DockPanel></Border>
    </Grid>
    <Expander x:Name="VariableEditor" Grid.Row="3" Header="搜索 / 添加观察变量（停止采集后修改）" IsEnabled="{Binding CanEdit}" Margin="0,8,0,0"><DockPanel Height="360"><WrapPanel DockPanel.Dock="Bottom"><TextBlock Text="采样率 / Hz" VerticalAlignment="Center"/><TextBox x:Name="SampleRate" Text="100" Width="90"/><Button Content="保存变量与采样率" Click="SaveVariables"/></WrapPanel><local:VariablePicker Variables="{Binding Variables}"/></DockPanel></Expander>

  </Grid>
</UserControl>
