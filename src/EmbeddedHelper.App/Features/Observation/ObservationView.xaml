<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="StartAction" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AddAction" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style x:Key="StopAction" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Style.Triggers><Trigger Property="IsEnabled" Value="True">
        <Setter Property="Background" Value="#FCEBEC"/><Setter Property="Foreground" Value="#B4232D"/><Setter Property="BorderBrush" Value="#B4232D"/>
      </Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel Margin="0,0,0,8">
      <TextBlock Text="MCU Viewer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,8"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Content="{Binding StartText}" Style="{StaticResource StartAction}" Click="StartObservation" IsEnabled="{Binding CanStart}"/>
        <Button x:Name="StopButton" Content="停止并释放" Style="{StaticResource StopAction}" Click="StopObservation" IsEnabled="{Binding CanStop}"/>
        <CheckBox x:Name="PauseObservation" Content="暂停显示" IsChecked="{Binding Paused}" VerticalAlignment="Center" Margin="0,0,16,8"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="频率设置（Hz）" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="SampleRate" Text="200" Width="64" Height="36" Margin="0,0,8,8"
                 IsEnabled="{Binding CanEdit}" AcceptsReturn="False" TextWrapping="NoWrap"
                 MinLines="1" MaxLines="1" TextAlignment="Center" VerticalContentAlignment="Center"
                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                 PreviewMouseWheel="IgnoreFrequencyMouseWheel">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="FrequencyFrame" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"
                              VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FrequencyFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Layer}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <Button Content="保存数据" Style="{StaticResource ToolbarButton}" ToolTip="保存当前变量选择和采样频率；不导出采集数据。" Click="SaveVariables" IsEnabled="{Binding CanEdit}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="更新 ELF" Style="{StaticResource ToolbarButton}" Click="ParseElf" IsEnabled="{Binding CanEdit}"/>
        <Button Content="添加变量" Style="{StaticResource AddAction}" Click="AddVariables" IsEnabled="{Binding CanEdit}"/>
      </StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding ElfStatus}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <Expander Header="解析详细信息" Visibility="{Binding HasElfDetails, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,6"><TextBox Text="{Binding ElfDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="260" MaxWidth="600"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="ConfigurationSummary" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <Border Grid.Row="1" x:Name="ConfigurationRequired" Visibility="{Binding NeedsConfiguration, Converter={StaticResource VisibleWhenTrue}}" Background="{StaticResource AccentSoft}" Padding="8" Margin="0,0,0,8">
          <StackPanel><TextBlock x:Name="ConfigurationIssue" Text="{Binding Issue}" TextWrapping="Wrap"/><Button x:Name="ConfigureButton" Content="{Binding ConfigureText}" Click="Configure" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <local:VariablePicker Grid.Row="2" x:Name="Picker" Variables="{Binding Variables}" CanEdit="{Binding CanEdit}"/>
      </Grid>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="12"><DockPanel>
        <WrapPanel DockPanel.Dock="Top"><TextBlock Text="变量曲线 · 最近 2000 点 · 前 16 项" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,12,8"/><CheckBox x:Name="IndependentScale" Content="分道独立缩放" IsChecked="{Binding IndependentScale}" IsEnabled="{Binding CanScaleIndependently}" ToolTip="{Binding ScaleHint}" ToolTipService.ShowOnDisabled="True">
          <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{StaticResource ConsoleText}"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource ConsoleMuted}"/><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers></Style></CheckBox.Style>
        </CheckBox></WrapPanel>
        <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:ObservationPlot x:Name="Plot" ClipToBounds="True" Series="{Binding Series}" Times="{Binding Times}" Labels="{Binding PlotLabels}" Independent="{Binding IsChecked, ElementName=IndependentScale}"/></ScrollViewer>
          <TextBlock x:Name="PlotEmpty" Text="{Binding PlotEmpty}" Visibility="{Binding PlotMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource ConsoleMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </DockPanel></Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="ObservationStatus" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,6,0,0"/>
  </Grid>
</UserControl>
