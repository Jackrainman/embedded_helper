<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="StartButton" Content="开始采集" Style="{StaticResource Primary}" Click="StartObservation" IsEnabled="False"/><Button x:Name="StopButton" Content="停止并释放" Click="StopObservation" IsEnabled="False"/><CheckBox x:Name="PauseObservation" Content="暂停显示"/></WrapPanel><TextBlock Text="查看变量" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock x:Name="ConfigurationSummary" Text="读取本工程已保存的观察设置。" Style="{StaticResource Description}"/>
      <Border x:Name="ConfigurationRequired" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><DockPanel><Button x:Name="ConfigureButton" DockPanel.Dock="Right" Content="去观察设置" Click="Configure" Margin="14,0,0,0"/><StackPanel><TextBlock Text="先补全必要设置" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="ConfigurationIssue" Text="请打开工程，并在观察设置中保存连接方式、变量或 RTT。" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    </StackPanel>
    <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="更新变量地址" Click="ParseElf"/><TextBlock x:Name="ObservationStatus" Text="未连接 · ELF 与固件匹配未核验" Foreground="{StaticResource MutedBrush}" Margin="0,8" TextWrapping="Wrap"/></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Surface}"><Grid><DataGrid x:Name="VariableGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="变量 / 类型" Binding="{Binding Label}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="地址" Binding="{Binding Address}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="当前值" Binding="{Binding Value}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="VariablesEmpty" Text="尚无已配置变量&#x0a;请先在工程的观察设置中勾选并保存。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="18"/></Grid></Border>
      <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="变量曲线 · 最近 2000 个显示点" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,0,8"/><Grid><Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="PlotSizeChanged"/><TextBlock x:Name="PlotEmpty" Text="开始采集后显示曲线" Foreground="{StaticResource ConsoleMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DockPanel></Border>
    </Grid>
    <GroupBox Grid.Row="3" Header="RTT · Up 0" Margin="0,14,0,0" Padding="8"><DockPanel><Button DockPanel.Dock="Right" Content="清屏" Click="ClearRtt" VerticalAlignment="Top"/><Grid><TextBox x:Name="RttText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0" BorderThickness="0" Background="{StaticResource ConsoleBrush}" Foreground="{StaticResource ConsoleText}"/><TextBlock x:Name="RttEmpty" Text="等待本地 RTT 输出" Foreground="{StaticResource ConsoleMuted}" Margin="12" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid></DockPanel></GroupBox>
  </Grid>
</UserControl>
