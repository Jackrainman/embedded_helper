<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="StartButton" Content="{Binding StartText}" Style="{StaticResource Primary}" Click="StartObservation" IsEnabled="{Binding CanStart}"/><Button x:Name="StopButton" Content="停止并释放" Click="StopObservation" IsEnabled="{Binding CanStop}"/><CheckBox x:Name="PauseObservation" Content="暂停显示" IsChecked="{Binding Paused}"/></WrapPanel><TextBlock Text="查看变量" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock x:Name="ConfigurationSummary" Text="{Binding Summary}" Style="{StaticResource Description}"/>
      <Border x:Name="ConfigurationRequired" Visibility="{Binding NeedsConfiguration, Converter={StaticResource VisibleWhenTrue}}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><DockPanel><Button x:Name="ConfigureButton" DockPanel.Dock="Right" Content="{Binding ConfigureText}" Click="Configure" Margin="14,0,0,0"/><StackPanel><TextBlock Text="先补全必要设置" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="ConfigurationIssue" Text="{Binding Issue}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    </StackPanel>
    <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="更新变量地址" Click="ParseElf"/><TextBlock x:Name="ObservationStatus" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="0,8" TextWrapping="Wrap"/></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Surface}"><Grid><DataGrid x:Name="VariableGrid" IsReadOnly="True" ItemsSource="{Binding VisibleRows}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="变量 / 类型" Binding="{Binding Label}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="地址" Binding="{Binding Address}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="当前值" Binding="{Binding Value}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="VariablesEmpty" Text="{Binding VariablesEmpty}" Visibility="{Binding VariablesMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="18"/></Grid></Border>
      <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="变量曲线 · 最近 2000 个显示点" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,0,8"/><Grid><local:ObservationPlot x:Name="Plot" ClipToBounds="True" Series="{Binding Series}"/><TextBlock x:Name="PlotEmpty" Text="{Binding PlotEmpty}" Visibility="{Binding PlotMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource ConsoleMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DockPanel></Border>
    </Grid>
    <GroupBox Grid.Row="3" Header="RTT · Up 0" Margin="0,14,0,0" Padding="8"><DockPanel><Button DockPanel.Dock="Right" Content="清屏" Click="ClearRtt" VerticalAlignment="Top"/><Grid><TextBox x:Name="RttText" IsReadOnly="True" Text="{Binding RttText, Mode=OneWay}" TextChanged="RttTextChanged" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0" BorderThickness="0" Background="{StaticResource ConsoleBrush}" Foreground="{StaticResource ConsoleText}"/><TextBlock x:Name="RttEmpty" Text="{Binding RttEmpty}" Visibility="{Binding RttMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource ConsoleMuted}" Margin="12" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid></DockPanel></GroupBox>
  </Grid>
</UserControl>
