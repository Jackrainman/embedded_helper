<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8">
      <TextBlock Text="MCU Viewer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button x:Name="StartButton" Content="{Binding StartText}" Style="{StaticResource Primary}" Click="StartObservation" IsEnabled="{Binding CanStart}"/>
      <Button x:Name="StopButton" Content="停止并释放" Click="StopObservation" IsEnabled="{Binding CanStop}"/>
      <CheckBox x:Name="PauseObservation" Content="暂停显示" IsChecked="{Binding Paused}"/>
      <TextBlock Text="Hz" VerticalAlignment="Center" Margin="10,0,2,0"/><TextBox x:Name="SampleRate" Text="100" Width="64" IsEnabled="{Binding CanEdit}"/>
      <Button Content="保存观察" Click="SaveVariables" IsEnabled="{Binding CanEdit}"/>
      <Button Content="更新 ELF" Click="ParseElf" IsEnabled="{Binding CanEdit}"/>
    </WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="260" MaxWidth="600"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="ConfigurationSummary" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <Border Grid.Row="1" x:Name="ConfigurationRequired" Visibility="{Binding NeedsConfiguration, Converter={StaticResource VisibleWhenTrue}}" Background="{StaticResource AccentSoft}" Padding="8" Margin="0,0,0,8">
          <StackPanel><TextBlock x:Name="ConfigurationIssue" Text="{Binding Issue}" TextWrapping="Wrap"/><Button x:Name="ConfigureButton" Content="{Binding ConfigureText}" Click="Configure" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <local:VariablePicker Grid.Row="2" x:Name="Picker" Variables="{Binding Variables}" CanEdit="{Binding CanEdit}"/>
      </Grid>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="12"><DockPanel>
        <WrapPanel DockPanel.Dock="Top"><TextBlock Text="变量曲线 · 最近 2000 点 · 前 16 项" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,12,8"/><CheckBox x:Name="IndependentScale" Content="分道独立缩放" IsChecked="True" Foreground="{StaticResource ConsoleText}"/></WrapPanel>
        <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:ObservationPlot x:Name="Plot" ClipToBounds="True" Series="{Binding Series}" Labels="{Binding PlotLabels}" Independent="{Binding IsChecked, ElementName=IndependentScale}"/></ScrollViewer>
          <TextBlock x:Name="PlotEmpty" Text="{Binding PlotEmpty}" Visibility="{Binding PlotMissing, Converter={StaticResource VisibleWhenTrue}}" Foreground="{StaticResource ConsoleMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </DockPanel></Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="ObservationStatus" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,6,0,0"/>
  </Grid>
</UserControl>
