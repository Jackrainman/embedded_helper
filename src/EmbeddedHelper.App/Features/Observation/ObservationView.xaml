<UserControl x:Class="EmbeddedHelper.App.ObservationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
          <WrapPanel><ComboBox x:Name="TransportBox" SelectedIndex="0" Width="145"><ComboBoxItem Content="本地 USB"/><ComboBoxItem Content="远程 IP"/></ComboBox><TextBlock Text="探针序列号" VerticalAlignment="Center" Margin="0,0,8,10"/><TextBox x:Name="ProbeSerial" Width="135"/><TextBlock Text="请求 Hz" VerticalAlignment="Center" Margin="0,0,8,10"/><TextBox x:Name="SampleRate" Text="100" Width="65"/><CheckBox x:Name="EnableRtt" Content="本地 RTT 通道 0" IsChecked="True"/><Button x:Name="StartButton" Content="开始采集" Style="{StaticResource Primary}" Click="StartObservation"/><Button Content="停止并释放" Click="StopObservation"/><CheckBox x:Name="PauseObservation" Content="暂停显示"/></WrapPanel>
          <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="更新变量地址" Click="ParseElf"/><TextBlock x:Name="ObservationStatus" Text="未连接 · ELF 与固件匹配未核验" Foreground="{StaticResource MutedBrush}" Margin="0,8" TextWrapping="Wrap"/></DockPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="VariableGrid" ItemsSource="{Binding Variables}" SelectionMode="Extended"><DataGrid.Columns><DataGridCheckBoxColumn Header="观察" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="变量 / 类型" Binding="{Binding Label}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="100" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="变量曲线 · 最近 2000 个显示点" Foreground="{StaticResource ConsoleMuted}" Margin="0,0,0,8"/><Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="PlotSizeChanged"/></DockPanel></Border>
          </Grid>
          <GroupBox Grid.Row="3" Header="RTT · Up 0" Margin="0,14,0,0" Padding="8"><DockPanel><Button DockPanel.Dock="Right" Content="清屏" Click="ClearRtt" VerticalAlignment="Top"/><TextBox x:Name="RttText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0" BorderThickness="0"/></DockPanel></GroupBox>
        </Grid>
</UserControl>
