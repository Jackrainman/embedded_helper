<UserControl x:Class="EmbeddedHelper.App.VariablePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel><TextBlock Text="搜索变量" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="按名称、类型或标识搜索；不区分大小写"/></DockPanel>
 <TextBlock Grid.Row="1" x:Name="Hint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <GroupBox Header="搜索结果"><DataGrid x:Name="Results" IsReadOnly="True"><DataGrid.Columns>
 <DataGridTextColumn Header="变量 / 类型" Binding="{Binding Label}" Width="*"/>
 <DataGridTextColumn Header="状态" Binding="{Binding Variable.Status}" Width="110"/>
 <DataGridTemplateColumn Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Margin="2,0" Padding="6,2" MinHeight="24" Height="28" Content="添加" IsEnabled="{Binding Variable.Supported}" Click="Add"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid></GroupBox>
 <GroupBox Grid.Column="2" Header="已观察 · 最多 64 项"><DataGrid x:Name="SelectedRows" IsReadOnly="True"><DataGrid.Columns>
 <DataGridTextColumn Header="变量 / 类型" Binding="{Binding Label}" Width="*"/>
 <DataGridTemplateColumn Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Margin="2,0" Padding="6,2" MinHeight="24" Height="28" Content="移除" Click="Remove"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid></GroupBox>
 </Grid></Grid>
</UserControl>
