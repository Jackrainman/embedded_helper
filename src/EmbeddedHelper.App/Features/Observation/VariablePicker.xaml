<UserControl x:Class="EmbeddedHelper.App.VariablePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
 <UserControl.Resources>
  <Style x:Key="VariableName" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style>
  <Style x:Key="AddButton" TargetType="Button"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="4,2"/><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="28"/>
   <Style.Triggers><DataTrigger Binding="{Binding Variable.Supported}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type local:VariablePicker}}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Layout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="搜索名称、成员完整路径或类型" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type local:VariablePicker}}}"/>
  <TextBlock Grid.Row="1" x:Name="Hint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>
  <GroupBox x:Name="SearchResults" Grid.Row="2" Header="搜索结果"><DataGrid x:Name="Results" IsReadOnly="True"><DataGrid.Columns>
   <DataGridTemplateColumn Header="变量" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:VariableNameText FullName="{Binding Variable.Name}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="添加" Click="Add" Style="{StaticResource AddButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></GroupBox>
  <GridSplitter x:Name="Divider" Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
  <GroupBox x:Name="AddedVariables" Grid.Row="4" Header="已添加变量 · 最多64项"><DataGrid x:Name="SelectedRows" IsReadOnly="True"><DataGrid.Columns>
   <DataGridTemplateColumn Header="显示" Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ShowPlot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ToolTip="在右侧显示曲线；取消勾选仍继续采集和记录" AutomationProperties.Name="显示变量曲线"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="变量" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:VariableNameText FullName="{Binding Variable.Name}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="80"/>
   <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="移除" Margin="0" Padding="4,2" MinHeight="24" Height="28" IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type local:VariablePicker}}}" Click="Remove"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></GroupBox>
 </Grid>
</UserControl>
