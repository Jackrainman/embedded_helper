<UserControl x:Class="EmbeddedHelper.App.RemoteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer IsEnabled="{Binding CanEdit}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,0,0">
    <TextBlock Text="远程配置" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="连接参数保存在本工程；远程探针端口与网页端口不同。" Style="{StaticResource Description}"/>
    <GroupBox Header="J-Link Remote Server"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="服务器主机名 / IP"/><TextBox x:Name="RemoteHost" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="网页地址（可选）"/><TextBox x:Name="WebAddress" Text="{Binding Web, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="远程变量与网页 RTT 手动二选一；开始远程采集前请在网页停止 RTT。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="远程探针端口"/><TextBox x:Name="RemotePort" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="本机 GDB 端口"/><TextBox x:Name="GdbPort" Text="{Binding GdbPort, UpdateSourceTrigger=PropertyChanged}"/><Button Content="前往 RTT 监视" Click="OpenWeb" HorizontalAlignment="Left" Margin="0,0,0,0"/></StackPanel>
    </Grid></GroupBox>
    <TextBlock Text="VS Code 接入前，先到设置与诊断准备工具并绑定本机入口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    <CheckBox x:Name="UseEideUpload" IsChecked="{Binding EideUpload}" Content="同时切换 EIDE 上传按钮（适配 3.27.2，可恢复）"/>
    <WrapPanel><Button Content="预览 VS Code 接入" Click="PreviewIntegration"/><Button Content="仅预览连接参数" Click="PreviewConfig"/><Button x:Name="ApplyConfigButton" Content="应用已预览的修改" Style="{StaticResource Primary}" Click="ApplyConfig" IsEnabled="{Binding CanApply}"/></WrapPanel>
    <GroupBox Header="修改预览"><TextBox x:Name="ConfigPreview" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" Height="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" Margin="0"/></GroupBox>
    <Expander Header="恢复与移除" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><WrapPanel><Button Content="预览移除接入" Click="PreviewRemoveIntegration"/><Button Content="恢复未完成写入" Click="RecoverConfig"/></WrapPanel><TextBlock Text="旧工程重新应用可迁移命令；保留本地条目和未受管字段。所有修改先预览，写入不执行构建、烧录或调试。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
