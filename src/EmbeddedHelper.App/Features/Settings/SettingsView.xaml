<UserControl x:Class="EmbeddedHelper.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="设置与诊断" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="维护本机工具路径；连接参数从右上角配置，变量选择与频率在 MCU Viewer 设置。" Style="{StaticResource Description}"/>
    <GroupBox Header="本机工具路径"><StackPanel>
      <TextBlock Text="SEGGER JLink_x64.dll" FontWeight="SemiBold"/>
      <TextBlock Text="点击“选择 DLL”，选择已安装 J-Link 软件中的 JLink_x64.dll 文件（不是文件夹），然后保存本机设置并运行环境检查。本软件不分发 SEGGER 库。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="选择 DLL" Click="BrowseDll" Margin="0,4,0,10"/><TextBox x:Name="DllPath"/></DockPanel>
      <TextBlock Text="DWARF5 解析工具（可选）" FontWeight="SemiBold"/>
      <TextBlock Text="DWARF4 使用内置解析；DWARF5 使用 arm-none-eabi-readelf.exe。自动检测 EIDE，也可填写完整路径。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      <TextBox x:Name="ReadElfPath"/>
      <WrapPanel><Button Content="保存本机设置" Click="SaveSettings" Style="{StaticResource Primary}"/><Button Content="环境检查" Click="EnvironmentCheck"/><Button Content="打开日志目录" Click="OpenLogs"/></WrapPanel>
    </StackPanel></GroupBox>
    <GroupBox Header="Debug_LAN 工具版本"><StackPanel>
      <TextBlock Text="从 Template 官方 Release 下载，或导入原版 ZIP；每个版本独立保留。" Style="{StaticResource Description}" Margin="0,0,0,6"/>
      <WrapPanel><ComboBox x:Name="ToolVersionBox" DisplayMemberPath="Version" Width="160"/><Button Content="检查官方更新" Click="RefreshTools" Margin="0,4,8,10"/><Button Content="下载并校验" Click="DownloadTool" Margin="0,4,8,10"/><Button Content="导入离线 ZIP" Click="ImportTool" Margin="0,4,8,10"/><Button Content="绑定本机 VS Code 入口" Click="BindCli" Margin="0,4,8,10"/></WrapPanel>
      <TextBlock x:Name="ToolStatus" Text="尚未准备工具；请先选择版本。移动便携目录后需重新绑定入口。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel></GroupBox>
    <GroupBox Header="环境诊断"><TextBox x:Name="EnvironmentText" IsReadOnly="True" MinHeight="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0"/></GroupBox>
    <Expander Header="使用说明" Margin="0,0,0,14"><TextBlock Text="1. 将 EmbeddedHelper.exe 放在可写目录并双击，升级时保留 data。&#x0a;2. 工程中选择目标、解析 ELF，保存共享连接，在 MCU Viewer 搜索添加变量。&#x0a;3. 停止并释放采集后，再使用外部烧录或调试工具。&#x0a;4. 串口原始记录保存在 data/serial/records；主机顺序不代表对端确认。&#x0a;5. 硬件链路仍需实机验收。" TextWrapping="Wrap" LineHeight="24" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
