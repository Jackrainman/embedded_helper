<UserControl x:Class="EmbeddedHelper.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="设置与诊断" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="维护本机工具路径；连接参数从右上角配置，变量选择与频率在 MCU Viewer 设置。" Style="{StaticResource Description}"/>
    <GroupBox Header="采集与解析环境" x:Name="LocalToolsPanel"><StackPanel>
      <TextBlock Text="J-Link 软件组件（DLL）" FontWeight="SemiBold"/>
      <TextBlock Text="用于 MCU 变量采集和本地 RTT。选择后自动校验并保存；软件版本与实体探针分别配置。" Style="{StaticResource Description}"/>
      <TextBlock x:Name="JLinkStatus" Text="尚未指定组件" TextWrapping="Wrap"/>
      <ComboBox x:Name="JLinkCandidates" DisplayMemberPath="Label" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></ComboBox.ItemContainerStyle></ComboBox>
      <WrapPanel><Button Content="自动查找" Click="DiscoverTools"/><Button Content="手动选择文件" Click="BrowseDll"/></WrapPanel>
      <Expander Header="J-Link 详细设置"><TextBox x:Name="DllPath" ToolTip="JLink_x64.dll 完整路径"/></Expander>
      <TextBlock Text="ELF 变量解析组件" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="用于读取变量名称、类型和地址。内置解析始终可用；部分 ELF 需要外部工具，打开文件时自动判断。" Style="{StaticResource Description}"/>
      <TextBlock x:Name="ReadElfStatus" Text="内置解析可用" TextWrapping="Wrap"/>
      <ComboBox x:Name="ReadElfCandidates" DisplayMemberPath="Label" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></ComboBox.ItemContainerStyle></ComboBox>
      <WrapPanel><Button Content="自动查找" Click="DiscoverTools"/><Button Content="手动选择文件" Click="BrowseReadElf"/></WrapPanel>
      <Expander Header="ELF 解析详细设置"><TextBox x:Name="ReadElfPath" ToolTip="arm-none-eabi-readelf.exe 完整路径；留空使用自动查找"/></Expander>
      <TextBlock x:Name="DiscoveryNotes" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
      <WrapPanel><Button Content="检查配置" Click="EnvironmentCheck"/><Button Content="打开日志目录" Click="OpenLogs"/></WrapPanel>
      <TextBlock Text="文件校验不加载 DLL、不连接设备；实际加载及目标连接在开始采集时验证。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel></GroupBox>
    <GroupBox Header="LAN_Debug 工具管理"><StackPanel>
      <TextBlock Text="从 Template 官方 Release 下载，或导入原版 ZIP；每个版本独立保留。" Style="{StaticResource Description}" Margin="0,0,0,6"/>
      <WrapPanel><ComboBox x:Name="ToolVersionBox" DisplayMemberPath="Version" Width="160"/><Button Content="检查官方更新" Click="RefreshTools" Margin="0,4,8,10"/><Button Content="下载并校验" Click="DownloadTool" Margin="0,4,8,10"/><Button Content="导入离线 ZIP" Click="ImportTool" Margin="0,4,8,10"/></WrapPanel>
      <TextBlock x:Name="ToolStatus" Text="这里管理本机工具缓存；工程接入请在工程页一键完成。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel></GroupBox>
    <GroupBox Header="环境诊断"><TextBox x:Name="EnvironmentText" IsReadOnly="True" MinHeight="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0"/></GroupBox>
    <Expander Header="使用说明" Margin="0,0,0,14"><TextBlock Text="1. 将 EmbeddedHelper.exe 放在可写目录并双击，升级时保留 data。&#x0a;2. 工程中选择目标、解析 ELF，保存共享连接，在 MCU Viewer 搜索添加变量。&#x0a;3. 停止并释放采集后，再使用外部烧录或调试工具。&#x0a;4. 串口原始记录保存在 data/serial/records；主机顺序不代表对端确认。&#x0a;5. 硬件链路仍需实机验收。" TextWrapping="Wrap" LineHeight="24" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
