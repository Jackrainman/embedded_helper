<UserControl x:Class="EmbeddedHelper.App.SerialView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbeddedHelper.App">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel><StackPanel><TextBlock Text="端口"/><ComboBox x:Name="SerialPortBox" IsEnabled="{Binding CanEdit}" IsEditable="True" Width="280" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel><TextBlock Text="波特率"/><ComboBox x:Name="BaudBox" IsEnabled="{Binding CanEdit}" IsEditable="True" Text="115200" Width="120"><ComboBoxItem Content="9600"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="1000000"/><ComboBoxItem Content="5000000"/></ComboBox></StackPanel><StackPanel><TextBlock Text="数据位"/><ComboBox x:Name="DataBitsBox" IsEnabled="{Binding CanEdit}" SelectedIndex="3"><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/></ComboBox></StackPanel><StackPanel><TextBlock Text="校验"/><ComboBox x:Name="ParityBox" IsEnabled="{Binding CanEdit}"/></StackPanel><StackPanel><TextBlock Text="停止位"/><ComboBox x:Name="StopBitsBox" IsEnabled="{Binding CanEdit}"/></StackPanel><StackPanel><TextBlock Text="流控"/><ComboBox x:Name="FlowBox" IsEnabled="{Binding CanEdit}" Width="150"/></StackPanel></WrapPanel>
          <WrapPanel Grid.Row="1"><Button Content="刷新端口" Click="RefreshPorts"/><Button x:Name="ConnectSerialButton" Content="{Binding ToggleText}" IsEnabled="{Binding CanToggle}" Click="ToggleSerial" Style="{StaticResource Primary}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,8"><Ellipse x:Name="SerialConnectionLight" Width="13" Height="13" Fill="{Binding ConnectionBrush}" Margin="0,0,6,0"/><TextBlock x:Name="SerialConnectionLabel" Text="{Binding ConnectionText}" VerticalAlignment="Center"/></StackPanel><CheckBox x:Name="RecordSerial" IsEnabled="{Binding CanEdit}" Content="保存双向原始记录" ToolTip="在打开串口时应用；修改后重新打开生效" IsChecked="True"/><ComboBox x:Name="EncodingBox" Width="100" SelectionChanged="SerialEncodingChanged" ToolTip="切换编码/HEX会重置实时显示；历史快照和原始记录不变"/><CheckBox x:Name="HexDisplay" Content="HEX 显示" Checked="SerialEncodingChanged" Unchecked="SerialEncodingChanged"/><Button x:Name="FreezeButton" Content="冻结当前并分栏" Click="ToggleFreeze"/><Button Content="清屏" Click="ClearSerial"/></WrapPanel>
          <StackPanel Grid.Row="2"><WrapPanel><TextBlock Text="接收" Foreground="{StaticResource MutedBrush}"/><Border Width="24" Height="8" Background="{StaticResource SerialRxBrush}" Margin="6,0,14,0"/><TextBlock Text="发送" Foreground="{StaticResource MutedBrush}"/><Border Width="24" Height="8" Background="{StaticResource SerialTxBrush}" Margin="6,0,14,0"/><TextBlock Text="{Binding PeriodicText}" TextWrapping="Wrap"/></WrapPanel><TextBlock TextWrapping="Wrap" x:Name="SerialStats" Text="未连接 · 1 Mbps 待实机验收，5 Mbps 为实验档；RS485仅支持转接器硬件自动换向" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/></StackPanel>
          <Grid Grid.Row="3" x:Name="LogColumns" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="FrozenColumn" Width="0"/></Grid.ColumnDefinitions>
            <local:SerialLogView x:Name="FrozenLog" Grid.Column="2" Visibility="Collapsed"/>
            <GridSplitter x:Name="LogSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" Visibility="Collapsed"/>
            <local:SerialLogView x:Name="LiveLog" Grid.Column="0"/>
          </Grid>
          <StackPanel Grid.Row="4"><TextBlock Text="最近发送" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="SendHistoryBox" SelectionChanged="SelectSendHistory" ToolTip="最近发送内容（最多20项）"/><TextBox x:Name="SendText" AcceptsReturn="True" MinHeight="66" MaxHeight="110" VerticalScrollBarVisibility="Auto" ToolTip="发送文本或以空格分隔的十六进制字节"/></StackPanel>
          <WrapPanel Grid.Row="5"><CheckBox x:Name="HexSend" Content="HEX 发送"/><ComboBox x:Name="NewlineBox" SelectedIndex="0"><ComboBoxItem Content="不加换行"/><ComboBoxItem Content="LF"/><ComboBoxItem Content="CRLF"/></ComboBox><Button Content="发送" Click="SendSerial" Style="{StaticResource Primary}"/><TextBlock Text="周期 ms" VerticalAlignment="Center" Margin="8,0,8,10"/><TextBox x:Name="SendPeriod" Text="1000" Width="80"/><Button Content="周期发送" IsEnabled="{Binding CanStartPeriodic}" Click="StartPeriodic"/><Button Content="取消周期" IsEnabled="{Binding CanStopPeriodic}" Click="StopPeriodic"/><Button Content="打开记录目录" Click="OpenRecords"/></WrapPanel>
        </Grid>
</UserControl>
