<Application x:Class="EmbeddedHelper.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F3F5F9"/><Setter Property="Foreground" Value="#17243B"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="MinWidth" Value="100"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,16,10"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="24,13"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Padding" Value="16"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE5EF"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE5EF"/></Style>
  </Application.Resources>
</Application>
