<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <ProjectReference Include="../../src/EmbeddedHelper.Core/EmbeddedHelper.Core.csproj" />
    <ProjectReference Include="../../src/EmbeddedHelper.Worker/EmbeddedHelper.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/EmbeddedHelper.App/Features/Observation/ObservationViewModel.cs" Link="App/ObservationViewModel.cs" />
    <Compile Include="../../src/EmbeddedHelper.App/Features/Observation/VariableRow.cs" Link="App/VariableRow.cs" />
    <Compile Include="../../src/EmbeddedHelper.App/Features/Remote/RemoteViewModel.cs" Link="App/RemoteViewModel.cs" />
  </ItemGroup>
  <Target Name="PrepareWorkerForTests" AfterTargets="Build">
    <MSBuild Projects="../../src/EmbeddedHelper.Worker/EmbeddedHelper.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="WorkerTarget" />
    </MSBuild>
    <PropertyGroup><WorkerOutputDirectory>@(WorkerTarget->'%(RootDir)%(Directory)')</WorkerOutputDirectory></PropertyGroup>
    <ItemGroup><WorkerFiles Include="$(WorkerOutputDirectory)*;$(WorkerOutputDirectory)runtimes/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
